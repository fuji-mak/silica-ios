<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>twitter</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(SILICA_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDisplayName</key>
	<string>$(SILICA_APP_DISPLAY_NAME)</string>
	<key>SilicaURLScheme</key>
	<string>$(SILICA_URL_SCHEME)</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Silica records stays in the background so your daily location log can be saved locally.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Silica uses your location to record where you stayed.</string>
	<key>NSMotionUsageDescription</key>
	<string>Silica uses motion history to distinguish stays from pass-through movement and summarize travel.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Silica uses Face ID to protect your private location history.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Silica saves your customized Pro card artwork to your photo library.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
